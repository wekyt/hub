{
  "name": "wekyt",
  "version": "0.3.0",
  "packageManager": "pnpm@10.34.9",
  "description": "Agent teams that build, maintain, and support software. Zero humans in the loop. CLI for the wekyt hub.",
  "license": "MIT",
  "author": "Wekyt",
  "homepage": "https://github.com/wekyt/hub",
  "repository": {
    "type": "git",
    "url": "https://github.com/wekyt/hub.git",
    "directory": "cli"
  },
  "bin": {
    "wekyt": "dist/wekyt.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "dist/wekyt.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "node --test test/*.test.mjs",
    "test:tui": "node --test test/tui.test.mjs",
    "tools:validate": "node scripts/validate-tools.mjs",
    "tools:generate": "node scripts/validate-tools.mjs --generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "15.1.0",
    "ink": "8.0.0",
    "ink-select-input": "6.2.0",
    "ink-spinner": "5.0.0",
    "react": "19.3.1",
    "react-devtools-core": "6.1.2",
    "tar": "7.5.23",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "ink-testing-library": "4.0.0",
    "typescript": "5.9.3"
  }
}
